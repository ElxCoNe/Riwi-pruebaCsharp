@model PruebaRiwi.Models.SportPlace

@{
    ViewData["Title"] = "Editar Espacio Deportivo";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mt-3">
            <div class="card-header bg-white">
                <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Editar Espacio Deportivo</h4>
            </div>
            <div class="card-body">

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <form asp-action="Edit" method="post">
                    <input asp-for="Id" type="hidden" />
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo de Espacio</label>
                        <select asp-for="Type" class="form-select" required>
                            <option value="Football">Fútbol</option>
                            <option value="Basketball">Baloncesto</option>
                            <option value="Swimming">Piscina</option>
                            <option value="Tennis">Tenis</option>
                            <option value="Other">Otro</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Capacidad</label>
                        <input asp-for="Capacity" type="number" class="form-control" min="1" required />
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Volver
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Actualizar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>